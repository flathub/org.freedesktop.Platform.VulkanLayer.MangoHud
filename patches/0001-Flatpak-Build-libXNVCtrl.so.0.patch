From d68d3785151c2d20f6500e639930639d26fed7e7 Mon Sep 17 00:00:00 2001
From: Jonatas Esteves <jntesteves@gmail.com>
Date: Tue, 14 Jul 2026 13:17:51 -0300
Subject: [PATCH] Flatpak: Build libXNVCtrl.so.0

---
 src/Makefile              | 3 +++
 src/libXNVCtrl/Makefile   | 3 ++-
 src/libXNVCtrl/xnvctrl.mk | 5 +++++
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/Makefile b/src/Makefile
index fe97103..5515aa2 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -105,6 +105,9 @@ endif
 XNVCTRL_DIR             ?= libXNVCtrl
 XCONFIG_PARSER_DIR      ?= XF86Config-parser
 COMMON_UTILS_DIR        ?= common-utils
+XNVCTRL_SHARED          ?= $(XNVCTRL_DIR)/libXNVCtrl.so.0
+#XNVCTRL_LIB            ?= $(XNVCTRL_ARCHIVE)
+XNVCTRL_LIB             ?= $(XNVCTRL_SHARED)
 COMMON_UNIX_DIR         ?= common-unix
 VIRTUAL_RESOLUTIONS_DIR ?= $(COMMON_UNIX_DIR)/virtual-resolutions
 
diff --git a/src/libXNVCtrl/Makefile b/src/libXNVCtrl/Makefile
index 1e84ecb..490d762 100644
--- a/src/libXNVCtrl/Makefile
+++ b/src/libXNVCtrl/Makefile
@@ -50,8 +50,9 @@ LDFLAGS += $(XNVCTRL_LDFLAGS)
 
 .PHONY: clean
 
-all: $(LIBXNVCTRL)
+all: $(LIBXNVCTRL) libXNVCtrl.so
 
 clean:
 	rm -rf $(LIBXNVCTRL) *~ \
 		$(OUTPUTDIR)/*.o $(OUTPUTDIR)/*.d
+	rm -f libXNVCtrl.so libXNVCtrl.so.*
diff --git a/src/libXNVCtrl/xnvctrl.mk b/src/libXNVCtrl/xnvctrl.mk
index e6be2ef..0de2481 100644
--- a/src/libXNVCtrl/xnvctrl.mk
+++ b/src/libXNVCtrl/xnvctrl.mk
@@ -47,3 +47,8 @@ $(eval $(call DEFINE_OBJECT_RULE,TARGET,$(LIBXNVCTRL_SRC)))
 
 $(LIBXNVCTRL) : $(LIBXNVCTRL_OBJ)
 	$(call quiet_cmd,AR) ru $@ $(LIBXNVCTRL_OBJ)
+
+libXNVCtrl.so: $(LIBXNVCTRL_OBJ)
+	$(CC) -shared -Wl,-soname=$@.0 -o $@.0.0.0 $(LDFLAGS) $^ -lXext -lX11
+	ln -s $@.0.0.0 $@.0
+	ln -s $@.0 $@
-- 
2.55.0

